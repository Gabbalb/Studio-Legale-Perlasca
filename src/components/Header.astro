---
interface Props {
  currentPage?: string;
}

const { currentPage = '/' } = Astro.props;

const navItems = [
  { href: '/', label: 'Home' },
  { href: '/su-di-noi', label: 'Su di noi' },
  { href: '/la-nostra-politica', label: 'La nostra politica' },
  { href: '/dove-trovarci', label: 'Dove trovarci' },
];
---

<!-- Top Contact Bar -->
<div class="bg-primary-950 text-slate-300 text-xs py-2 px-4 sm:px-6 lg:px-8 border-b border-primary-900/60 hidden sm:block">
  <div class="max-w-7xl mx-auto flex items-center justify-between">
    <div class="flex items-center gap-6">
      <span class="flex items-center gap-1.5 text-slate-400">
        <svg class="w-3.5 h-3.5 text-gold-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        Via Armando Diaz 7, 25121 Brescia (BS)
      </span>
      <span class="flex items-center gap-1.5 text-slate-400">
        <svg class="w-3.5 h-3.5 text-gold-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
        </svg>
        PEC: cristiano.perlasca@brescia.pecavvocati.it
      </span>
    </div>

    <div class="flex items-center gap-4">
      <a href="tel:+3903046785" class="hover:text-gold-300 transition-colors flex items-center gap-1.5 font-medium">
        <svg class="w-3.5 h-3.5 text-gold-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
        </svg>
        Tel: 030 46785
      </a>
      <span class="text-primary-800">|</span>
      <a href="tel:+39335235766" class="hover:text-gold-300 transition-colors">
        Cell. Avv. Perlasca: +39 335 23 5766
      </a>
    </div>
  </div>
</div>

<!-- Main Header Navigation -->
<header class="sticky top-0 z-50 bg-white/98 backdrop-blur-md border-b border-slate-200/90 shadow-xs">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Official Logo and Studio Name -->
      <a href="/" class="flex items-center gap-3.5 group">
        <img 
          src="/images/logoimage_page-0001-1.jpg" 
          alt="Studio Legale Perlasca" 
          class="h-12 w-auto object-contain transition-transform duration-200 group-hover:scale-105"
        />
        <div class="flex flex-col">
          <span class="font-serif font-bold text-primary-950 text-base sm:text-lg tracking-wide uppercase leading-tight group-hover:text-primary-800 transition-colors">
            STUDIO LEGALE PERLASCA
          </span>
          <span class="text-[11px] font-sans text-slate-500 uppercase tracking-wider font-medium">
            Avvocati Civilisti • Brescia dal 1994
          </span>
        </div>
      </a>

      <!-- Desktop Nav Menu -->
      <nav class="hidden md:flex items-center gap-1 lg:gap-2">
        {navItems.map((item) => {
          const isActive = currentPage === item.href || (item.href !== '/' && currentPage.startsWith(item.href));
          return (
            <a
              href={item.href}
              class={`px-3.5 py-2 rounded-md text-sm font-medium transition-all duration-150 ${
                isActive
                  ? 'text-primary-950 font-bold bg-slate-100 border-b-2 border-primary-900'
                  : 'text-slate-600 hover:text-primary-950 hover:bg-slate-50'
              }`}
            >
              {item.label}
            </a>
          );
        })}
      </nav>

      <!-- Desktop Quick CTA -->
      <div class="hidden lg:flex items-center gap-3">
        <a 
          href="/dove-trovarci" 
          class="px-4 py-2.5 rounded-lg text-xs font-bold uppercase tracking-wider text-primary-950 bg-gold-400 hover:bg-gold-500 shadow-xs transition-colors duration-150"
        >
          Fissa Appuntamento
        </a>
      </div>

      <!-- Mobile Hamburger Button -->
      <button 
        id="mobile-nav-toggle" 
        type="button" 
        class="md:hidden p-2 rounded-lg text-slate-700 hover:text-primary-950 hover:bg-slate-100 focus:outline-hidden"
        aria-label="Apri menu"
        aria-expanded="false"
      >
        <svg id="icon-open" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="icon-close" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>

    </div>
  </div>

  <!-- Mobile Drawer -->
  <div id="mobile-nav-menu" class="hidden md:hidden border-t border-slate-200 bg-white px-4 pt-3 pb-6 space-y-2 shadow-xl">
    {navItems.map((item) => {
      const isActive = currentPage === item.href || (item.href !== '/' && currentPage.startsWith(item.href));
      return (
        <a
          href={item.href}
          class={`block px-3.5 py-2.5 rounded-lg text-base font-medium transition-colors ${
            isActive
              ? 'bg-primary-50 text-primary-950 font-bold border-l-4 border-primary-900 pl-4'
              : 'text-slate-700 hover:bg-slate-50'
          }`}
        >
          {item.label}
        </a>
      );
    })}

    <div class="pt-4 border-t border-slate-100 flex flex-col gap-2">
      <a 
        href="tel:+3903046785" 
        class="flex items-center justify-center gap-2 w-full px-4 py-3 rounded-lg text-sm font-bold text-white bg-primary-950 hover:bg-primary-900 transition-colors"
      >
        <svg class="w-4 h-4 text-gold-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
        </svg>
        <span>Chiama lo Studio: 030 46785</span>
      </a>
      <a 
        href="tel:+39335235766" 
        class="flex items-center justify-center gap-2 w-full px-4 py-2.5 rounded-lg text-xs font-semibold text-slate-700 bg-slate-100 hover:bg-slate-200 transition-colors"
      >
        <span>Cell. Avv. Perlasca: +39 335 23 5766</span>
      </a>
    </div>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-nav-toggle');
  const navMenu = document.getElementById('mobile-nav-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  if (toggleBtn && navMenu && iconOpen && iconClose) {
    toggleBtn.addEventListener('click', () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      toggleBtn.setAttribute('aria-expanded', String(!isExpanded));
      navMenu.classList.toggle('hidden');
      iconOpen.classList.toggle('hidden');
      iconClose.classList.toggle('hidden');
    });
  }
</script>
