---
interface Props {
  name: string;
  role: string;
  phone: string;
  phoneFormatted: string;
  email?: string;
  cvUrl?: string;
  description?: string;
}

const {
  name,
  role,
  phone,
  phoneFormatted,
  email,
  cvUrl,
  description
} = Astro.props;
---

<div class="bg-white rounded-2xl p-6 sm:p-8 border border-slate-200/80 shadow-xs hover:shadow-md transition-all duration-300 flex flex-col justify-between group">
  <div>
    <div class="flex items-center justify-between gap-4 mb-4">
      <div class="w-12 h-12 rounded-xl bg-navy-50 border border-navy-100 flex items-center justify-center text-navy-900 group-hover:bg-navy-900 group-hover:text-gold-400 transition-colors duration-300">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
        </svg>
      </div>
      <span class="text-xs font-semibold px-3 py-1 rounded-full bg-slate-100 text-slate-700">
        {role}
      </span>
    </div>

    <h3 class="font-serif font-bold text-xl sm:text-2xl text-navy-950 mb-1">
      {name}
    </h3>
    <p class="text-xs uppercase tracking-wider text-gold-700 font-semibold mb-4">
      Iscritto all'Ordine degli Avvocati di Brescia
    </p>

    {description && (
      <p class="text-sm text-slate-600 leading-relaxed mb-6">
        {description}
      </p>
    )}
  </div>

  <div class="space-y-3 pt-4 border-t border-slate-100">
    <a 
      href={`tel:${phone}`} 
      class="flex items-center gap-3 text-sm font-semibold text-navy-900 hover:text-navy-700 transition-colors p-2 rounded-lg hover:bg-slate-50"
    >
      <div class="w-8 h-8 rounded-lg bg-navy-100/60 flex items-center justify-center text-navy-800 shrink-0">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
        </svg>
      </div>
      <span>{phoneFormatted}</span>
    </a>

    {email && (
      <a 
        href={`mailto:${email}`} 
        class="flex items-center gap-3 text-xs font-medium text-slate-600 hover:text-navy-900 transition-colors p-2 rounded-lg hover:bg-slate-50 break-all"
      >
        <div class="w-8 h-8 rounded-lg bg-navy-100/60 flex items-center justify-center text-navy-800 shrink-0">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
        </div>
        <span class="truncate"><span class="font-semibold text-slate-500 mr-1">PEC:</span>{email}</span>
      </a>
    )}

    {cvUrl && (
      <div class="pt-2">
        <a 
          href={cvUrl} 
          target="_blank" 
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 w-full px-4 py-2.5 rounded-lg text-xs font-bold uppercase tracking-wider text-navy-950 bg-gold-400 hover:bg-gold-500 shadow-xs hover:shadow-md transition-all duration-200"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          <span>Scarica Curriculum Vitae (PDF)</span>
        </a>
      </div>
    )}
  </div>
</div>
