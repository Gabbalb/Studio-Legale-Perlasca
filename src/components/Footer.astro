            </svg>
            <a href="mailto:cristiano.perlasca@brescia.pecavvocati.it" class="text-[11px] text-slate-300 hover:text-white break-all transition-colors">
              cristiano.perlasca@brescia.pecavvocati.it (PEC)
            </a>
          </li>
        </ul>
      </div>

      <!-- Lawyers Direct & Social -->
      <div class="space-y-3">
        <h4 class="font-serif text-white font-semibold text-sm tracking-wider uppercase border-b border-navy-800 pb-2">
          Professionisti
        </h4>
        <div class="space-y-2 text-xs">
          <div>
            <span class="text-white font-semibold block">Avv. Cristiano Perlasca</span>
            <a href="tel:+39335235766" class="text-slate-300 hover:text-white transition-colors">+39 335 23 5766</a>
          </div>
          <div>
            <span class="text-white font-semibold block">Avv. Paola Scolari</span>
            <a href="tel:+393331205093" class="text-slate-300 hover:text-white transition-colors">+39 333 120 5093</a>
          </div>
