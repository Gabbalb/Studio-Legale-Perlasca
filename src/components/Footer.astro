            <div>
              <a href="tel:+3903046785" class="hover:text-white transition-colors font-semibold">Tel: +39 030 46785</a>
              <span class="text-slate-500 text-[11px] block">Fax: +39 030 46785</span>
            </div>
          </li>
          <li class="flex items-start gap-2.5">
            <svg class="w-4 h-4 text-slate-400 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
