    </div>
  </div>

  <div class="border-t border-navy-900 bg-navy-950 py-5 text-center text-xs text-slate-500">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-3">
      <p>© {currentYear} Studio Legale Perlasca • Avv. Cristiano Perlasca & Avv. Paola Scolari. P.IVA / CF.</p>
