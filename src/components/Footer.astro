---
const currentYear = new Date().getFullYear();
---

<footer class="bg-navy-950 text-slate-300 border-t border-navy-900">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 lg:py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 lg:gap-12">
      
      <!-- Studio Brand & Intro -->
      <div class="space-y-4">
        <div class="flex items-center gap-3">
          <img 
            src="/images/logoimage_page-0001-1.jpg" 
            alt="Studio Legale Perlasca" 
            class="h-10 w-auto object-contain bg-white/10 rounded-xs p-1" 
          />
          <div class="flex flex-col">
            <span class="font-serif font-bold text-white text-base tracking-wide uppercase leading-tight">
              STUDIO LEGALE PERLASCA
            </span>
            <span class="text-[10px] text-slate-400 uppercase tracking-widest font-semibold">
              Brescia
            </span>
          </div>
        </div>
        <p class="text-xs text-slate-400 leading-relaxed">
          Dal 1994 al fianco di chi ha bisogno... dall'università al diritto internazionale, familiare ed assicurativo. Assistenza legale giudiziale e stragiudiziale con serietà, trasparenza e dedizione.
        </p>
      </div>

      <!-- Quick Nav -->
      <div class="space-y-3">
        <h4 class="font-serif text-white font-semibold text-sm tracking-wider uppercase border-b border-navy-800 pb-2">
          Pagine
        </h4>
        <ul class="space-y-2 text-xs text-slate-400">
          <li><a href="/" class="hover:text-white transition-colors">Home</a></li>
          <li><a href="/su-di-noi" class="hover:text-white transition-colors">Su di noi</a></li>
          <li><a href="/la-nostra-politica" class="hover:text-white transition-colors">La nostra politica</a></li>
          <li><a href="/dove-trovarci" class="hover:text-white transition-colors">Dove trovarci</a></li>
          <li><a href="/documents/CVCristianoperlasca.pdf" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors text-slate-300 font-medium">Curriculum Vitae (PDF)</a></li>
        </ul>
      </div>

      <!-- Office Contacts -->
      <div class="space-y-3">
        <h4 class="font-serif text-white font-semibold text-sm tracking-wider uppercase border-b border-navy-800 pb-2">
          Sede & Contatti
        </h4>
        <ul class="space-y-2.5 text-xs text-slate-300">
          <li class="flex items-start gap-2.5">
            <svg class="w-4 h-4 text-slate-400 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <a 
              href="https://maps.google.com/?q=Via+Armando+Diaz+7+25121+Brescia" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="hover:text-white transition-colors"
            >
              Via Armando Diaz 7, 25121 Brescia (BS)
            </a>
          </li>
          <li class="flex items-center gap-2.5">
            <svg class="w-4 h-4 text-slate-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
