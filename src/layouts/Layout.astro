---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  keywords?: string;
}

const {
  title = "Studio Legale Perlasca | Avvocato Civilista a Brescia",
  description = "Studio legale Perlasca Dal 1994 al fianco di chi ha bisogno... ...dall'università al diritto internazionale, familiare ed assicurativo.",
  keywords = "Studio Legale Brescia, Avvocato Cristiano Perlasca, Avvocato Paola Scolari, Diritto Civile Brescia, Diritto Assicurativo, Diritto di Famiglia, Diritto Internazionale"
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://studiolegaleavvocatoperlasca.com');
const currentPath = Astro.url.pathname;
---

<!DOCTYPE html>
<html lang="it" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <title>{title}</title>
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/jpeg" href="/favicon.jpg" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/images/logoimage_page-0001-1.jpg" />
    <meta property="og:locale" content="it_IT" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>
  <body class="min-h-screen flex flex-col bg-slate-50/50 text-slate-800 antialiased selection:bg-gold-200 selection:text-primary-950">
    <Header currentPage={currentPath} />
    
    <main class="flex-grow">
      <slot />
    </main>

    <Footer />
  </body>
</html>
