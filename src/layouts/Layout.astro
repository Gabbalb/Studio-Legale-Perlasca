---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  pageCss?: string;
}

const {
  title = "Studiolegaleavvocatoperlasca",
  description = "Studio legale Perlasca Dal 1994 al fianco di chi ha bisogno...",
  pageCss
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://studiolegaleavvocatoperlasca.com');
---

<!DOCTYPE html>
<html style="font-size: 16px;" lang="it">
  <head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta charset="utf-8">
    <meta name="keywords" content="STUDIO LEGALE PERLASCA, SU DI NOI, LE NOSTRE CAPACITA', STUDIO LEGALE BRESCIA, studio legale brescia, perlasca, cristiano perlasca, avvocato">
    <meta name="description" content={description}>
    <title>{title}</title>
    <link rel="canonical" href={canonicalURL}>
    <link rel="icon" href="/favicon.jpg">

    <!-- Original Nicepage Core & Theme Styles -->
    <link rel="stylesheet" href="/css/nicepage.css" media="screen">
    <link rel="stylesheet" href="/css/customizer-style.css" media="screen">
    <link rel="stylesheet" href="/css/theme-style.css" media="screen">
    <link rel="stylesheet" href="/css/header.css" media="screen">
    <link rel="stylesheet" href="/css/footer.css" media="screen">
    {pageCss && <link rel="stylesheet" href={pageCss} media="screen" />}

    <!-- Original Google Fonts used by Nicepage -->
    <link id="u-theme-google-font" rel="stylesheet" href="https://fonts.googleapis.com/css?family=Roboto:100,100i,300,300i,400,400i,500,500i,700,700i,900,900i|Open+Sans:300,300i,400,400i,600,600i,700,700i,800,800i|Merriweather:300,300i,400,400i,700,700i,900,900i|Raleway:100,100i,200,200i,300,300i,400,400i,500,500i,600,600i,700,700i,800,800i,900,900i">
    <link id="u-page-google-font" rel="stylesheet" href="https://fonts.googleapis.com/css?family=Merriweather:300,300i,400,400i,700,700i,900,900i|Raleway:100,100i,200,200i,300,300i,400,400i,500,500i,600,600i,700,700i,800,800i,900,900i">

    <!-- Nicepage Scripts -->
    <script is:inline src="/js/jquery.js" defer></script>
    <script is:inline src="/js/nicepage.js" defer></script>
  </head>
  <body class="u-body u-xl-mode" data-style="blank" data-posts="" data-global-section-properties='{"colorings":{"light":["clean"],"colored":["clean"],"dark":["dark"]}}' data-source="blank" data-password="" data-lang="it" data-page-sections-style="" data-page-coloring-types='{"light":["clean"],"colored":["clean"],"dark":["dark"]}' data-page-category='"Basic"' data-app-version="5.2.4">
    <Header />
    
    <slot />

    <Footer />
  </body>
</html>
