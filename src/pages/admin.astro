---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Accesso Amministratore | Studio Legale Perlasca"
  description="Area riservata di accesso amministratore per lo Studio Legale Perlasca."
>
  <div class="min-h-[75vh] flex items-center justify-center py-16 px-4 sm:px-6 lg:px-8 bg-slate-50">
    <div class="max-w-md w-full bg-white p-8 sm:p-10 rounded-sm border border-slate-200 shadow-sm space-y-8">
      
      <!-- Titolo pulito -->
      <div class="text-center space-y-2">
        <h1 class="font-serif text-2xl sm:text-3xl font-bold text-navy-950 tracking-tight">
          Accesso Amministratore
        </h1>
      </div>

      <!-- Form Campi e Pulsante -->
      <form class="space-y-5" onsubmit="event.preventDefault();">
        <div>
          <label for="username" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-1.5">
            Nome utente o Email
          </label>
          <input 
            type="text" 
            id="username" 
            name="username" 
            required 
            class="w-full px-4 py-3 text-sm bg-white border border-slate-300 rounded-xs focus:outline-hidden focus:ring-2 focus:ring-navy-950 focus:border-navy-950 transition-colors"
            placeholder="Inserisci nome utente o email"
          />
        </div>

        <div>
          <label for="password" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-1.5">
            Password
          </label>
          <input 
            type="password" 
            id="password" 
            name="password" 
            required 
            class="w-full px-4 py-3 text-sm bg-white border border-slate-300 rounded-xs focus:outline-hidden focus:ring-2 focus:ring-navy-950 focus:border-navy-950 transition-colors"
            placeholder="••••••••"
          />
        </div>

        <div class="pt-2">
          <button 
            type="submit" 
            class="w-full py-3 px-4 rounded-xs text-xs font-bold uppercase tracking-wider text-white bg-navy-950 hover:bg-navy-900 border border-navy-950 transition-colors duration-150 cursor-pointer shadow-xs"
          >
            Accedi
          </button>
        </div>
      </form>

    </div>
  </div>
</Layout>
