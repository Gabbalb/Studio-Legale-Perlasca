---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Studio Legale Perlasca | Avvocato Civilista a Brescia"
  description="Studio legale Perlasca Dal 1994 al fianco di chi ha bisogno... dall'università al diritto internazionale, familiare ed assicurativo."
>

  <!-- HERO SECTION -->
  <section class="relative bg-navy-950 text-white overflow-hidden py-24 sm:py-32 lg:py-36 border-b border-navy-900">
    <div class="absolute inset-0 z-0">
      <img 
        src="/images/pexels-abdullah-almutairi-5442149.jpg" 
        alt="Studio Legale Perlasca Brescia" 
        class="w-full h-full object-cover object-center opacity-20"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-navy-950 via-navy-950/80 to-navy-950/60"></div>
    </div>

    <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-6">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-xs bg-white/5 border border-white/15 text-slate-300 text-xs font-semibold tracking-wider uppercase">
        Studio Legale a Brescia
      </div>

      <h1 class="font-serif text-3xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-white leading-tight">
        STUDIO LEGALE PERLASCA
      </h1>

      <p class="text-base sm:text-xl text-slate-300 font-light max-w-3xl mx-auto leading-relaxed">
        Dal 1994 al fianco di chi ha bisogno... dall'università al diritto internazionale, familiare ed assicurativo.
      </p>

      <div class="pt-4 flex flex-wrap items-center justify-center gap-4">
        <a 
          href="/dove-trovarci" 
          class="px-7 py-3 rounded-xs text-xs font-bold uppercase tracking-wider text-navy-950 bg-white hover:bg-slate-100 shadow-sm transition-colors duration-150"
        >
          Fissa un Appuntamento
        </a>
        <a 
          href="tel:+3903046785" 
          class="px-7 py-3 rounded-xs text-xs font-semibold uppercase tracking-wider text-white bg-transparent hover:bg-white/10 border border-white/30 transition-colors duration-150 flex items-center gap-2"
        >
          <svg class="w-3.5 h-3.5 text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          <span>Tel: 030 46785</span>
        </a>
      </div>
    </div>
  </section>

  <!-- SECTIONS: SU DI NOI & LO STUDIO -->
  <section class="py-16 sm:py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        
        <!-- Box 1: Su di noi -->
        <div class="bg-slate-50 border border-slate-200 rounded-sm overflow-hidden flex flex-col justify-between">
          <div class="h-64 sm:h-72 overflow-hidden relative">
            <img 
              src="/images/0457308993d05791316c37d3b424328bf2a99de63cd2c1c47ca816feab61f77ec15ec6fc3ba2f27c48cdb514076acb09ef267f95e218aa3993e912_1280.jpg" 
              alt="Su di noi - Studio Legale Perlasca" 
              class="w-full h-full object-cover"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-navy-950/85 via-navy-950/30 to-transparent"></div>
            <div class="absolute bottom-4 left-6">
              <span class="text-[11px] font-bold uppercase tracking-wider text-slate-300 bg-navy-950/90 px-2.5 py-1 rounded-xs">Esperienza</span>
              <h2 class="font-serif text-2xl sm:text-3xl font-bold text-white mt-1">SU DI NOI...</h2>
            </div>
          </div>
          
          <div class="p-6 sm:p-8 flex-grow flex flex-col justify-between space-y-6">
            <p class="text-slate-700 text-base sm:text-lg leading-relaxed">
              Laurea in giurisprudenza e <strong>più di 30 anni di esperienza</strong> ininterrotta in materia di diritto civile.
            </p>
            <div>
              <a 
                href="/documents/CVCristianoperlasca.pdf" 
                target="_blank" 
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xs text-xs font-bold uppercase tracking-wider text-white bg-navy-950 hover:bg-navy-900 transition-colors"
              >
                <svg class="w-4 h-4 text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
                <span>Leggi il CV (PDF)</span>
              </a>
            </div>
          </div>
        </div>

        <!-- Box 2: Lo Studio -->
        <div class="bg-slate-50 border border-slate-200 rounded-sm overflow-hidden flex flex-col justify-between">
          <div class="h-64 sm:h-72 overflow-hidden relative">
            <img 
              src="/images/287ced42e76bf0d6dd3ec2a67bb3b0a1b2c496a998c560ba9ea1da5e5a6e2a4f1771b9cc8528329c6e94beda08259f56bebb75095469f6b5a51c47_1280.jpg" 
              alt="Lo Studio Legale Perlasca" 
              class="w-full h-full object-cover"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-navy-950/85 via-navy-950/30 to-transparent"></div>
            <div class="absolute bottom-4 left-6">
              <span class="text-[11px] font-bold uppercase tracking-wider text-slate-300 bg-navy-950/90 px-2.5 py-1 rounded-xs">Storia</span>
              <h2 class="font-serif text-2xl sm:text-3xl font-bold text-white mt-1">LO STUDIO</h2>
            </div>
          </div>
          
          <div class="p-6 sm:p-8 flex-grow flex flex-col justify-between space-y-6">
            <p class="text-slate-700 text-sm sm:text-base leading-relaxed">
              Il nostro studio nasce nel <strong>1994</strong> e si è dedicato alla professione nonché all'attività di docenza presso l'<strong>UNIVERSITÀ DEGLI STUDI DI BRESCIA</strong> – Facoltà di Giurisprudenza, Cattedra di Diritto del Commercio Internazionale.
            </p>
            <div>
              <a 
                href="/su-di-noi" 
                class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xs text-xs font-bold uppercase tracking-wider text-navy-950 bg-white hover:bg-slate-100 border border-slate-300 transition-colors"
              >
                <span>Scopri di più</span>
                <span>→</span>
              </a>
            </div>
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- AREE DI COMPETENZA -->
  <section class="py-16 sm:py-20 bg-slate-50 border-y border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-2xl mx-auto mb-12 space-y-2">
        <span class="text-xs uppercase tracking-widest text-slate-500 font-bold">Ambiti di Attività</span>
        <h2 class="font-serif text-2xl sm:text-3xl font-bold text-navy-950">
          AREE DI COMPETENZA
        </h2>
        <p class="text-slate-600 text-sm sm:text-base">
          Tutti i settori in cui noi possiamo sostenerti
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        
        <!-- Area 1: Diritto Assicurativo -->
        <div class="bg-white rounded-sm p-7 border border-slate-200 shadow-xs flex flex-col items-center text-center space-y-4">
          <div class="w-12 h-12 rounded-xs bg-slate-100 text-navy-950 flex items-center justify-center border border-slate-200">
            <svg class="w-6 h-6 text-navy-950" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
          </div>
          <div class="w-10 h-px bg-slate-300"></div>
          <h3 class="font-serif font-bold text-lg text-navy-950">
            Diritto assicurativo
          </h3>
          <p class="text-xs text-slate-600 leading-relaxed">
            Consulenza e tutela giudiziale e stragiudiziale per sinistri, risarcimento danni, polizze e controversie con istituti assicurativi.
          </p>
        </div>

        <!-- Area 2: Diritto della Famiglia -->
        <div class="bg-white rounded-sm p-7 border border-slate-200 shadow-xs flex flex-col items-center text-center space-y-4">
          <div class="w-12 h-12 rounded-xs bg-slate-100 text-navy-950 flex items-center justify-center border border-slate-200">
            <svg class="w-6 h-6 text-navy-950" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
          </div>
          <div class="w-10 h-px bg-slate-300"></div>
          <h3 class="font-serif font-bold text-lg text-navy-950">
            Diritto della famiglia
          </h3>
          <p class="text-xs text-slate-600 leading-relaxed">
            Assistenza per separazioni, divorzi, affidamento di minori, successioni ed eredità con riservatezza, competenza ed equilibrio.
          </p>
        </div>

        <!-- Area 3: Diritto Internazionale -->
        <div class="bg-white rounded-sm p-7 border border-slate-200 shadow-xs flex flex-col items-center text-center space-y-4">
          <div class="w-12 h-12 rounded-xs bg-slate-100 text-navy-950 flex items-center justify-center border border-slate-200">
            <svg class="w-6 h-6 text-navy-950" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <div class="w-10 h-px bg-slate-300"></div>
          <h3 class="font-serif font-bold text-lg text-navy-950">
            Diritto Internazionale
          </h3>
          <p class="text-xs text-slate-600 leading-relaxed">
            Consulenza nel commercio estero, contrattualistica internazionale ed arbitrati, forte dell'esperienza di docenza accademica.
          </p>
        </div>

      </div>

    </div>
  </section>

  <!-- SPLIT CARDS: POLITICA & DOVE TROVARLO -->
  <section class="py-16 sm:py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        
        <!-- Card 1: La nostra Politica -->
        <div class="relative rounded-sm overflow-hidden p-8 sm:p-10 text-white min-h-[260px] flex flex-col justify-between border border-navy-900 shadow-sm">
          <img 
            src="/images/52e3dd40425bb108f5d08460962934761237d6ed5a4c704f75267ad0904ac151_1280.jpg" 
            alt="La nostra politica" 
            class="absolute inset-0 w-full h-full object-cover"
          />
          <div class="absolute inset-0 bg-navy-950/85"></div>
          <div class="relative z-10 space-y-2">
            <h3 class="font-serif text-2xl font-bold text-white">La nostra Politica</h3>
            <p class="text-sm text-slate-300">Ecco cosa pensiamo e la nostra visione sulla trasparenza...</p>
          </div>
          <div class="relative z-10 pt-6">
            <a 
              href="/la-nostra-politica" 
              class="inline-block px-5 py-2.5 rounded-xs text-xs font-bold uppercase tracking-wider text-navy-950 bg-white hover:bg-slate-100 transition-colors"
            >
              Scopri di più
            </a>
          </div>
        </div>

        <!-- Card 2: Dove trovarci -->
        <div class="bg-slate-50 rounded-sm p-8 sm:p-10 border border-slate-200 min-h-[260px] flex flex-col justify-between shadow-xs">
          <div class="space-y-2">
            <h3 class="font-serif text-2xl font-bold text-navy-950">Il nostro studio e dove trovarlo...</h3>
            <p class="text-sm text-slate-600">
              Ecco il nostro studio pronto ed adatto ad ogni esigenza. Visita la nostra gallery e scopri la nostra posizione in centro a Brescia.
            </p>
          </div>
          <div class="pt-6">
            <a 
              href="/dove-trovarci" 
              class="inline-block px-5 py-2.5 rounded-xs text-xs font-bold uppercase tracking-wider text-white bg-navy-950 hover:bg-navy-900 transition-colors"
            >
              Vieni a trovarci
            </a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- PROFESSIONISTI DELLO STUDIO WITH REAL PHOTOS -->
  <section class="py-16 sm:py-20 bg-slate-50 border-t border-slate-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center mb-12 space-y-1">
        <span class="text-xs uppercase tracking-widest text-slate-500 font-bold">I Legali</span>
        <h2 class="font-serif text-2xl sm:text-3xl font-bold text-navy-950">
          I Professionisti dello Studio
        </h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-8">
        
        <!-- Avv. Cristiano Perlasca -->
        <div class="bg-white rounded-sm border border-slate-200 text-center shadow-xs overflow-hidden flex flex-col">
          <div class="h-64 sm:h-72 overflow-hidden bg-slate-100">
            <img 
              src="/images/cristiano.jpg" 
              alt="Avv. Cristiano Perlasca" 
              class="w-full h-full object-cover object-top"
            />
          </div>
          <div class="p-6 space-y-2 flex-grow flex flex-col justify-between">
            <div>
              <h4 class="font-serif font-bold text-xl text-navy-950">Cristiano Perlasca</h4>
              <p class="text-xs text-slate-500 font-semibold uppercase tracking-wider">Avvocato</p>
            </div>
            <div class="pt-3 border-t border-slate-100 space-y-2">
              <a 
                href="tel:+39335235766" 
                class="block text-sm font-semibold text-navy-950 hover:text-navy-700"
              >
                +39 335 23 5766
              </a>
              <a 
                href="/documents/CVCristianoperlasca.pdf" 
                target="_blank" 
                rel="noopener noreferrer"
                class="inline-block text-xs font-semibold text-slate-600 hover:text-navy-950 underline"
              >
                Scarica Curriculum (PDF)
              </a>
            </div>
          </div>
        </div>

        <!-- Avv. Paola Scolari -->
        <div class="bg-white rounded-sm border border-slate-200 text-center shadow-xs overflow-hidden flex flex-col">
          <div class="h-64 sm:h-72 overflow-hidden bg-slate-100">
            <img 
              src="/images/paola.jpg" 
              alt="Avv. Paola Scolari" 
              class="w-full h-full object-cover object-top"
            />
          </div>
          <div class="p-6 space-y-2 flex-grow flex flex-col justify-between">
            <div>
              <h4 class="font-serif font-bold text-xl text-navy-950">Paola Scolari</h4>
              <p class="text-xs text-slate-500 font-semibold uppercase tracking-wider">Avvocato</p>
            </div>
            <div class="pt-3 border-t border-slate-100">
              <a 
                href="tel:+393331205093" 
                class="block text-sm font-semibold text-navy-950 hover:text-navy-700"
              >
                +39 333 120 5093
              </a>
            </div>
          </div>
        </div>

      </div>

    </div>
  </section>

</Layout>
