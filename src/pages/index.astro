---
import Layout from '../layouts/Layout.astro';
import ContactCard from '../components/ContactCard.astro';

const competenceAreas = [
  {
    title: "Diritto Assicurativo",
    description: "Assistenza completa nella gestione dei sinistri, risarcimento del danno biologico e patrimoniale, contenziosi e controversie con le compagnie di assicurazione.",
    icon: `<svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>`,
    tag: "Settore Chiave"
  },
  {
    title: "Diritto di Famiglia",
    description: "Consulenza e patrocinio per separazioni, divorzi, affidamento dei minori, regimi patrimoniali tra coniugi, successioni ed eredità con la massima riservatezza.",
    icon: `<svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" /></svg>`,
    tag: "Tutela Persona"
  },
  {
    title: "Diritto Internazionale",
    description: "Consulenza nel commercio internazionale, contratti d'impresa transfrontalieri, arbitrati e contenziosi internazionali maturata con anni di docenza universitaria.",
    icon: `<svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`,
    tag: "Commercio Estero"
  },
  {
    title: "Diritto Civile Generale",
    description: "Assistenza giudiziale e stragiudiziale, redazione e revisione contratti, tutela dei diritti reali, locazioni, recupero crediti e responsabilità civile contrattuale ed extracontrattuale.",
    icon: `<svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3" /></svg>`,
    tag: "Assistenza Civile"
  }
];
---

<Layout 
  title="Studio Legale Perlasca | Avvocato Civilista a Brescia"
  description="Studio Legale Avv. Cristiano Perlasca a Brescia. Dal 1994 al fianco di chi ha bisogno: diritto civile, commerciale, internazionale, familiare ed assicurativo."
>
  
  <!-- HERO SECTION -->
  <section class="relative bg-navy-950 text-white overflow-hidden">
    <!-- Background Image with Overlay -->
    <div class="absolute inset-0 z-0">
      <img 
        src="/images/pexels-abdullah-almutairi-5442149.jpg" 
        alt="Studio Legale Perlasca Brescia" 
        class="w-full h-full object-cover object-center opacity-30 scale-105 transform animate-pulse duration-1000"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-navy-950 via-navy-950/90 to-navy-900/70"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 sm:py-32 lg:py-40">
      <div class="max-w-3xl space-y-6">
        
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-gold-500/10 border border-gold-400/30 text-gold-300 text-xs sm:text-sm font-semibold tracking-wide">
          <span class="w-2 h-2 rounded-full bg-gold-400 animate-ping"></span>
          <span>Studio Legale a Brescia • Fondato nel 1994</span>
        </div>

        <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-white leading-tight">
          STUDIO LEGALE <span class="text-gold-gradient">PERLASCA</span>
        </h1>

        <p class="text-lg sm:text-xl text-slate-300 font-light leading-relaxed">
          Dal 1994 al fianco di chi ha bisogno... dall'università al diritto internazionale, familiare ed assicurativo. Assistenza legale fondata su <strong class="text-white font-semibold">Fiducia</strong> e <strong class="text-white font-semibold">Trasparenza</strong>.
        </p>

        <div class="pt-4 flex flex-wrap items-center gap-4">
          <a 
            href="/dove-trovarci" 
            class="px-7 py-3.5 rounded-xl font-bold text-sm sm:text-base text-navy-950 bg-gold-400 hover:bg-gold-500 shadow-lg hover:shadow-xl transition-all duration-200"
          >
            Fissa un Appuntamento
          </a>
          <a 
            href="tel:+3903046785" 
            class="px-7 py-3.5 rounded-xl font-semibold text-sm sm:text-base text-white bg-white/10 hover:bg-white/20 border border-white/20 backdrop-blur-sm transition-all duration-200 flex items-center gap-2"
          >
            <svg class="w-5 h-5 text-gold-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <span>Tel: 030 46785</span>
          </a>
        </div>

        <!-- Trust Badges -->
        <div class="pt-8 border-t border-white/10 grid grid-cols-2 sm:grid-cols-3 gap-6 text-slate-400 text-xs sm:text-sm">
          <div>
            <span class="block text-xl sm:text-2xl font-bold text-white font-serif">30+</span>
            <span>Anni di esperienza</span>
          </div>
          <div>
            <span class="block text-xl sm:text-2xl font-bold text-white font-serif">100%</span>
            <span>Trasparenza sui costi</span>
          </div>
          <div class="col-span-2 sm:col-span-1">
            <span class="block text-xl sm:text-2xl font-bold text-white font-serif">Brescia</span>
            <span>Via Armando Diaz 7</span>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- KEY CARDS: SU DI NOI & LO STUDIO -->
  <section class="py-16 sm:py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12">
        
        <!-- Card 1: Esperienza & CV -->
        <div class="bg-gradient-to-br from-navy-900 to-navy-950 text-white rounded-3xl p-8 sm:p-10 shadow-lg relative overflow-hidden flex flex-col justify-between group">
          <div class="absolute top-0 right-0 -mt-8 -mr-8 w-48 h-48 bg-gold-500/10 rounded-full blur-2xl group-hover:bg-gold-500/20 transition-all duration-500"></div>
          
          <div class="space-y-4 relative z-10">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-gold-400/20 text-gold-300 text-xs font-bold uppercase tracking-wider">
              Competenza & Rigore
            </div>
            <h2 class="font-serif text-2xl sm:text-3xl font-bold text-white">
              SU DI NOI...
            </h2>
            <p class="text-slate-300 text-base sm:text-lg leading-relaxed font-light">
              Laurea in giurisprudenza e <strong>più di 30 anni di esperienza</strong> ininterrotta in materia di diritto civile, consulenza d'impresa e contenzioso giudiziale.
            </p>
          </div>

          <div class="pt-8 relative z-10">
            <a 
              href="/documents/CVCristianoperlasca.pdf" 
              target="_blank" 
              rel="noopener noreferrer"
              class="inline-flex items-center gap-3 px-6 py-3 rounded-xl font-bold text-sm text-navy-950 bg-gold-400 hover:bg-gold-300 shadow-md hover:shadow-lg transition-all duration-200"
            >
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
              <span>Leggi il CV (PDF)</span>
            </a>
          </div>
        </div>

        <!-- Card 2: Lo Studio & Docenza Universitaria -->
        <div class="bg-slate-50 border border-slate-200/80 rounded-3xl p-8 sm:p-10 shadow-xs hover:shadow-md transition-all duration-300 flex flex-col justify-between group">
          <div class="space-y-4">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-navy-100 text-navy-800 text-xs font-bold uppercase tracking-wider">
              La Nostra Storia
            </div>
            <h2 class="font-serif text-2xl sm:text-3xl font-bold text-navy-950">
              LO STUDIO
            </h2>
            <p class="text-slate-600 text-base sm:text-lg leading-relaxed">
              Il nostro studio nasce nel <strong>1994</strong> e si è dedicato fin da subito alla libera professione forense, nonché all'attività di docenza accademica presso l'<strong>UNIVERSITÀ DEGLI STUDI DI BRESCIA</strong> – Facoltà di Giurisprudenza, Cattedra di Diritto del Commercio Internazionale.
            </p>
          </div>

          <div class="pt-8">
            <a 
              href="/su-di-noi" 
              class="inline-flex items-center gap-2 text-sm font-bold text-navy-900 hover:text-navy-700 transition-colors group-hover:translate-x-1 duration-200"
            >
              <span>Scopri di più sulla nostra attività</span>
              <span class="text-gold-600">→</span>
            </a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- AREE DI COMPETENZA -->
  <section class="py-20 bg-slate-50 border-y border-slate-200/70">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-2xl mx-auto mb-16 space-y-3">
        <span class="text-xs font-bold uppercase tracking-widest text-gold-700">Specializzazioni Forensi</span>
        <h2 class="font-serif text-3xl sm:text-4xl font-bold text-navy-950">
          AREE DI COMPETENZA
        </h2>
        <p class="text-slate-600 text-base">
          Tutti i principali settori del diritto civile in cui possiamo offrirti consulenza strategica, assistenza giudiziale e tutela continuativa.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {competenceAreas.map((area) => (
          <div class="bg-white rounded-2xl p-7 border border-slate-200 shadow-xs hover:shadow-lg hover:border-gold-300 transition-all duration-300 flex flex-col justify-between group">
            <div>
              <div class="w-14 h-14 rounded-2xl bg-navy-50 text-navy-900 group-hover:bg-navy-900 group-hover:text-gold-400 flex items-center justify-center mb-6 transition-colors duration-300" set:html={area.icon} />
              
              <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400 block mb-1">
                {area.tag}
              </span>
              <h3 class="font-serif font-bold text-xl text-navy-950 mb-3 group-hover:text-navy-700 transition-colors">
                {area.title}
              </h3>
              <p class="text-sm text-slate-600 leading-relaxed">
                {area.description}
              </p>
            </div>

            <div class="pt-6 mt-4 border-t border-slate-100">
              <a href="/su-di-noi" class="text-xs font-bold text-navy-900 hover:text-gold-700 flex items-center gap-1">
                <span>Dettagli assistenza</span>
                <span>›</span>
              </a>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- TEAM PROFESSIONISTI -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-2xl mx-auto mb-16 space-y-3">
        <span class="text-xs font-bold uppercase tracking-widest text-gold-700">I Nostri Avvocati</span>
        <h2 class="font-serif text-3xl sm:text-4xl font-bold text-navy-950">
          I Professionisti dello Studio
        </h2>
        <p class="text-slate-600 text-base">
          Un filo diretto con il tuo legale di fiducia. Nello Studio Legale Perlasca ogni pratica è seguita personalmente, senza deleghe a terzi.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto">
        <ContactCard 
          name="Cristiano Perlasca"
          role="Avvocato Patrocinante"
          phone="+39335235766"
          phoneFormatted="+39 335 23 5766"
          email="cristiano.perlasca@brescia.pecavvocati.it"
          cvUrl="/documents/CVCristianoperlasca.pdf"
          description="Avvocato civilista dal 1994, già docente universitario di Diritto del Commercio Internazionale. Esperto in contenzioso civile, diritto assicurativo, contrattualistica e arbitrati."
        />

        <ContactCard 
          name="Paola Scolari"
          role="Avvocato"
          phone="+393331205093"
          phoneFormatted="+39 333 120 5093"
          description="Avvocato con pluriennale esperienza nell'assistenza e consulenza in diritto civile, diritto di famiglia, successioni e gestione personalizzata delle pratiche stragiudiziali e giudiziali."
        />
      </div>

    </div>
  </section>

  <!-- CALL TO ACTION BANNER -->
  <section class="bg-navy-900 text-white py-16 relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 flex flex-col lg:flex-row items-center justify-between gap-8">
      <div class="space-y-3 max-w-2xl text-center lg:text-left">
        <span class="text-xs font-bold uppercase tracking-widest text-gold-400">Preventivo Gratuito e Trasparente</span>
        <h2 class="font-serif text-3xl sm:text-4xl font-bold text-white">
          Hai un problema legale da risolvere?
        </h2>
        <p class="text-slate-300 text-base leading-relaxed">
          Ti forniremo in anticipo e gratuitamente una stima chiara e trasparente dei costi e delle attività da compiere per la migliore soluzione.
        </p>
      </div>

      <div class="flex flex-col sm:flex-row gap-4 shrink-0">
        <a 
          href="/la-nostra-politica" 
          class="px-6 py-3.5 rounded-xl font-bold text-sm text-navy-950 bg-gold-400 hover:bg-gold-300 text-center shadow-md transition-all duration-200"
        >
          La Nostra Politica
        </a>
        <a 
          href="tel:+3903046785" 
          class="px-6 py-3.5 rounded-xl font-bold text-sm text-white bg-white/10 hover:bg-white/20 border border-white/20 text-center transition-all duration-200"
        >
          Chiama: 030 46785
        </a>
      </div>
    </div>
  </section>

</Layout>
