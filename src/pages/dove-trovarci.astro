---
import Layout from '../layouts/Layout.astro';
import ContactCard from '../components/ContactCard.astro';

const studioPhotos = [
  {
    src: "/images/img_4531.jpg",
    alt: "Studio Legale Perlasca Brescia - Ingresso e Sala Riunioni",
    title: "Sala Consulenze"
  },
  {
    src: "/images/img_4532.jpg",
    alt: "Studio Legale Perlasca - Biblioteca e Banche Dati Giuridiche",
    title: "Biblioteca Giuridica"
  },
  {
    src: "/images/img_4544.jpg",
    alt: "Ufficio Avv. Cristiano Perlasca",
    title: "Studio Avvocato"
  },
  {
    src: "/images/img_4553.jpg",
    alt: "Dettaglio Studio Professionale Brescia",
    title: "Ambiente Riservato"
  },
  {
    src: "/images/img_4557.jpg",
    alt: "Studio Legale Brescia - Postazione Lavoro",
    title: "Postazioni Telematiche"
  },
  {
    src: "/images/img_4563.jpg",
    alt: "Studio Legale Brescia - Archivio Pratiche",
    title: "Archivio & Documentazione"
  }
];
---

<Layout 
  title="Dove Trovarci | Studio Legale Perlasca Brescia"
  description="Dove si trova lo Studio Legale Perlasca: Via Armando Diaz 7, 25121 Brescia (BS). Mappa interattiva Google Maps, galleria fotografica dello studio e recapiti diretti."
>
  
  <!-- PAGE HEADER -->
  <section class="bg-navy-950 text-white py-16 sm:py-24 relative overflow-hidden">
    <div class="absolute inset-0 opacity-20">
      <img 
        src="/images/img_4531.jpg" 
        alt="Studio Legale Perlasca Brescia" 
        class="w-full h-full object-cover"
      />
    </div>
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl space-y-4">
        <span class="inline-block text-xs font-bold uppercase tracking-widest text-gold-400 bg-gold-500/10 px-3 py-1 rounded-full border border-gold-400/20">
          Sede & Contatti
        </span>
        <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-white">
          Ecco dove trovarci
        </h1>
        <p class="text-slate-300 text-base sm:text-lg">
          La posizione su Google Maps, indicazioni stradali e le immagini del nostro studio a Brescia.
        </p>
      </div>
    </div>
  </section>

  <!-- LOCATION & MAP SECTION -->
  <section class="py-16 sm:py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
        
        <!-- Info Card -->
        <div class="lg:col-span-5 space-y-6">
          <div class="bg-slate-50 border border-slate-200 rounded-3xl p-8 sm:p-10 shadow-xs space-y-6">
            <div>
              <span class="text-xs font-bold uppercase tracking-widest text-gold-700 block mb-1">Vieni a Trovarci</span>
              <h2 class="font-serif text-2xl sm:text-3xl font-bold text-navy-950">
                Studio Legale Perlasca
              </h2>
            </div>

            <div class="space-y-4 text-slate-700 text-base">
              <div class="flex items-start gap-3.5">
                <div class="w-10 h-10 rounded-xl bg-navy-900 text-gold-400 flex items-center justify-center shrink-0">
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                </div>
                <div>
                  <span class="font-semibold text-navy-950 block">Indirizzo Sede:</span>
                  <p class="text-slate-600">Via Armando Diaz 7</p>
                  <p class="text-slate-600">25121 Brescia (BS) • Italia</p>
                </div>
              </div>

              <div class="flex items-start gap-3.5">
                <div class="w-10 h-10 rounded-xl bg-navy-900 text-gold-400 flex items-center justify-center shrink-0">
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                  </svg>
                </div>
                <div>
                  <span class="font-semibold text-navy-950 block">Recapiti Telefonici:</span>
                  <a href="tel:+3903046785" class="text-slate-900 hover:text-gold-700 font-bold block">Tel: +39 030 46785</a>
                  <span class="text-slate-500 text-sm block">Fax: +39 030 46785</span>
                  <a href="tel:+39335235766" class="text-navy-900 hover:text-gold-700 text-sm font-medium block mt-1">Cell. Avv. Perlasca: +39 335 23 5766</a>
                  <a href="tel:+393331205093" class="text-navy-900 hover:text-gold-700 text-sm font-medium block">Cell. Avv. Scolari: +39 333 120 5093</a>
                </div>
              </div>

              <div class="flex items-start gap-3.5">
                <div class="w-10 h-10 rounded-xl bg-navy-900 text-gold-400 flex items-center justify-center shrink-0">
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
                </div>
                <div>
                  <span class="font-semibold text-navy-950 block">PEC (Posta Certificata):</span>
                  <a href="mailto:cristiano.perlasca@brescia.pecavvocati.it" class="text-xs text-slate-700 hover:text-navy-900 font-medium break-all">
                    cristiano.perlasca@brescia.pecavvocati.it
                  </a>
                </div>
              </div>
            </div>

            <div class="pt-4 border-t border-slate-200">
              <a 
                href="https://maps.google.com/?q=Via+Armando+Diaz+7+25121+Brescia" 
                target="_blank" 
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center gap-2 w-full px-6 py-3.5 rounded-xl font-bold text-sm text-navy-950 bg-gold-400 hover:bg-gold-500 shadow-xs hover:shadow-md transition-all duration-200"
              >
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
                <span>Apri in Google Maps</span>
              </a>
            </div>
          </div>
        </div>

        <!-- Interactive Google Map Embed -->
        <div class="lg:col-span-7 rounded-3xl overflow-hidden border border-slate-200 shadow-md h-[450px] lg:h-[520px] bg-slate-100">
          <iframe 
            title="Posizione Studio Legale Perlasca - Via Armando Diaz 7 Brescia"
            width="100%" 
            height="100%" 
            style="border:0;" 
            loading="lazy" 
            allowfullscreen 
            referrerpolicy="no-referrer-when-downgrade"
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2793.5828453412356!2d10.220194876694857!3d45.53457197107519!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x47817646b9a8cfab%3A0x6b772c659e9c70b6!2sVia%20Armando%20Diaz%2C%207%2C%2025121%20Brescia%20BS!5e0!3m2!1sit!2sit!4v1700000000000!5m2!1sit!2sit"
          ></iframe>
        </div>

      </div>

    </div>
  </section>

  <!-- STUDIO PHOTO GALLERY -->
  <section class="py-20 bg-slate-50 border-t border-slate-200/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-2xl mx-auto mb-16 space-y-3">
        <span class="text-xs font-bold uppercase tracking-widest text-gold-700">Gli Spazi dello Studio</span>
        <h2 class="font-serif text-3xl sm:text-4xl font-bold text-navy-950">
          Ecco alcune immagini del nostro studio
        </h2>
        <p class="text-slate-600 text-base">
          Questo è il nostro studio a Brescia: professionale, riservato ed equipaggiato con i migliori strumenti per ogni tua esigenza di tutela legale.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {studioPhotos.map((photo) => (
          <div class="bg-white rounded-2xl overflow-hidden border border-slate-200 shadow-xs hover:shadow-lg transition-all duration-300 group">
            <div class="h-60 overflow-hidden relative">
              <img 
                src={photo.src} 
                alt={photo.alt} 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-navy-950/70 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
            </div>
            <div class="p-4 bg-white border-t border-slate-100">
              <h3 class="font-serif font-bold text-base text-navy-950">
                {photo.title}
              </h3>
              <p class="text-xs text-slate-500 mt-0.5">
                Studio Legale Perlasca • Brescia
              </p>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- TEAM PROFESSIONISTI -->
  <section class="py-20 bg-white border-t border-slate-200/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12 space-y-3">
        <h2 class="font-serif text-3xl font-bold text-navy-950">
          I Professionisti
        </h2>
        <p class="text-slate-600 text-sm sm:text-base">
          Trova la strada più veloce e fissa un appuntamento chiamando il numero 030 46785.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto">
        <ContactCard 
          name="Cristiano Perlasca"
          role="Avvocato Patrocinante"
          phone="+39335235766"
          phoneFormatted="+39 335 23 5766"
          email="cristiano.perlasca@brescia.pecavvocati.it"
          cvUrl="/documents/CVCristianoperlasca.pdf"
          description="Via Armando Diaz 7, Brescia (BS) • Tel. 030 46785"
        />

        <ContactCard 
          name="Paola Scolari"
          role="Avvocato"
          phone="+393331205093"
          phoneFormatted="+39 333 120 5093"
          description="Via Armando Diaz 7, Brescia (BS) • Tel. 030 46785"
        />
      </div>
    </div>
  </section>

</Layout>
