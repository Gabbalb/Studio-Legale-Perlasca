---
import Layout from '../layouts/Layout.astro';

const officePhotos = [
  { src: "/images/img_4531.jpg" },
  { src: "/images/img_4532.jpg" },
  { src: "/images/img_4544.jpg" },
  { src: "/images/img_4553.jpg" },
  { src: "/images/img_4557.jpg" },
  { src: "/images/img_4563.jpg" },
];
---

<Layout 
  title="Dove trovarci | Studio Legale Perlasca Brescia"
  description="La posizione su google maps e immagini del nostro studio in Via Armando Diaz 7, Brescia."
>

  <!-- PAGE HEADER -->
  <section class="bg-navy-950 text-white py-16 sm:py-20 relative overflow-hidden border-b border-navy-900">
    <div class="absolute inset-0 z-0 opacity-15">
      <img 
        src="/images/img_4531.jpg" 
        alt="Studio Legale Perlasca Brescia" 
        class="w-full h-full object-cover"
      />
    </div>
    <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-3">
      <span class="text-xs uppercase tracking-widest text-slate-400 font-bold">Studio Legale Perlasca</span>
      <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-white">
        Ecco dove trovarci
      </h1>
      <p class="text-sm sm:text-base text-slate-300">
        La posizione su google maps e immagini del nostro studio
      </p>
    </div>
  </section>

  <!-- 1. LOCATION & MAP SECTION (ORA IN ALTO) -->
  <section class="py-16 sm:py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <div class="text-center max-w-2xl mx-auto space-y-2">
        <span class="text-xs uppercase tracking-widest text-slate-500 font-bold">Indicazioni</span>
        <h2 class="font-serif text-2xl sm:text-3xl font-bold text-navy-950">
          Vieni a trovarci
        </h2>
        <p class="text-slate-600 text-sm sm:text-base">
          Ecco il modo più comodo per venirci a trovare... ti aspettiamo
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
        
        <!-- Address & Directions -->
        <div class="lg:col-span-5 bg-slate-50 rounded-sm p-8 border border-slate-200 shadow-xs flex flex-col justify-between space-y-6">
          <div class="space-y-4">
            <div>
              <span class="text-xs font-bold uppercase tracking-wider text-slate-500 block">Sede Principale</span>
              <h3 class="font-serif text-2xl font-bold text-navy-950">Studio legale Perlasca</h3>
            </div>

            <div class="space-y-2 text-slate-700 text-base">
              <p class="font-medium">Via Armando Diaz 7, Brescia, BS, 25121</p>
            </div>

            <div class="p-4 bg-white border-l-3 border-navy-950 rounded-xs space-y-1.5 text-slate-700 border border-slate-200">
              <span class="font-bold text-navy-950 block text-base font-serif">Ti aspettiamo...</span>
              <p class="text-xs text-slate-600">Trova la strada più veloce e fissa un appuntamento al:</p>
              <a 
                href="tel:+3903046785" 
                class="inline-block text-xl sm:text-2xl font-bold font-serif text-navy-950 hover:text-navy-700 pt-0.5 tracking-wide"
              >
                030 46785
              </a>
            </div>
          </div>

          <div class="space-y-2.5">
            <a 
              href="tel:+3903046785" 
              class="inline-flex items-center justify-center gap-2 w-full px-5 py-3 rounded-xs text-xs font-bold uppercase tracking-wider text-white bg-navy-950 hover:bg-navy-900 transition-colors shadow-xs"
            >
              <svg class="w-3.5 h-3.5 text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
              <span>Chiama per Fissare un Appuntamento</span>
            </a>
            <a 
              href="https://maps.google.com/?q=Via+Armando+Diaz+7+25121+Brescia" 
              target="_blank" 
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 w-full px-5 py-2.5 rounded-xs text-xs font-semibold uppercase tracking-wider text-navy-950 bg-white hover:bg-slate-100 border border-slate-300 transition-colors"
            >
              Apri su Google Maps →
            </a>
          </div>
        </div>

        <!-- Google Map Embed -->
        <div class="lg:col-span-7 rounded-sm overflow-hidden border border-slate-200 shadow-xs min-h-[360px] bg-slate-100">
          <iframe 
            title="Mappa Studio Legale Perlasca Brescia"
            width="100%" 
            height="100%" 
            style="border:0; min-height: 360px;" 
            loading="lazy" 
            allowfullscreen 
            referrerpolicy="no-referrer-when-downgrade"
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2793.5828453412356!2d10.220194876694857!3d45.53457197107519!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x47817646b9a8cfab%3A0x6b772c659e9c70b6!2sVia%20Armando%20Diaz%2C%207%2C%2025121%20Brescia%20BS!5e0!3m2!1sit!2sit!4v1700000000000!5m2!1sit!2sit"
          ></iframe>
        </div>

      </div>

    </div>
  </section>

  <!-- 2. OFFICE PHOTO GALLERY (ORA IN BASSO) -->
  <section class="py-16 sm:py-20 bg-slate-50 border-t border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-2xl mx-auto mb-12 space-y-2">
        <span class="text-xs uppercase tracking-widest text-slate-500 font-bold">Galleria Fotografica</span>
        <h2 class="font-serif text-2xl sm:text-3xl font-bold text-navy-950">
          Ecco alcune immagini
        </h2>
        <p class="text-slate-600 text-sm sm:text-base">
          Questo è il nostro studio a Brescia, professionale e adatto ad ogni tua esigenza
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {officePhotos.map((photo) => (
          <div class="bg-white rounded-sm overflow-hidden border border-slate-200 shadow-xs h-64 sm:h-72">
            <img 
              src={photo.src} 
              alt="Studio Legale Perlasca Brescia" 
              class="w-full h-full object-cover hover:scale-103 transition-transform duration-300"
              loading="lazy"
            />
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- 3. PROFESSIONISTI WITH REAL PHOTOS -->
  <section class="py-16 bg-white border-t border-slate-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center mb-10 space-y-1">
        <span class="text-xs uppercase tracking-widest text-slate-500 font-bold">I Legali</span>
        <h2 class="font-serif text-2xl sm:text-3xl font-bold text-navy-950">
          I Professionisti
        </h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-8">
        
        <div class="bg-slate-50 rounded-sm border border-slate-200 text-center shadow-xs overflow-hidden flex flex-col">
          <div class="h-64 sm:h-72 overflow-hidden bg-slate-100">
            <img 
              src="/images/cristiano.jpg" 
              alt="Avv. Cristiano Perlasca" 
              class="w-full h-full object-cover object-top"
            />
          </div>
          <div class="p-6 space-y-2 flex-grow flex flex-col justify-between">
            <div>
              <h4 class="font-serif font-bold text-xl text-navy-950">Cristiano Perlasca</h4>
              <p class="text-xs text-slate-500 font-semibold uppercase tracking-wider">Avvocato</p>
            </div>
            <div class="pt-3 border-t border-slate-200 space-y-2">
              <a href="tel:+39335235766" class="block text-sm font-semibold text-navy-950 hover:text-navy-700">
                +39 335 23 5766
              </a>
              <a 
                href="/documents/CVCristianoperlasca.pdf" 
                target="_blank" 
                rel="noopener noreferrer"
                class="inline-block text-xs font-semibold text-slate-600 hover:text-navy-950 underline"
              >
                Scarica Curriculum (PDF)
              </a>
            </div>
          </div>
        </div>

        <div class="bg-slate-50 rounded-sm border border-slate-200 text-center shadow-xs overflow-hidden flex flex-col">
          <div class="h-64 sm:h-72 overflow-hidden bg-slate-100">
            <img 
              src="/images/paola.jpg" 
              alt="Avv. Paola Scolari" 
              class="w-full h-full object-cover object-top"
            />
          </div>
          <div class="p-6 space-y-2 flex-grow flex flex-col justify-between">
            <div>
              <h4 class="font-serif font-bold text-xl text-navy-950">Paola Scolari</h4>
              <p class="text-xs text-slate-500 font-semibold uppercase tracking-wider">Avvocato</p>
            </div>
            <div class="pt-3 border-t border-slate-200">
              <a href="tel:+393331205093" class="block text-sm font-semibold text-navy-950 hover:text-navy-700">
                +39 333 120 5093
              </a>
            </div>
          </div>
        </div>

      </div>

    </div>
  </section>

</Layout>
