---
import Layout from '../layouts/Layout.astro';

const officePhotos = [
  { src: "/images/img_4531.jpg", title: "Sala Riunioni e Consulenze" },
  { src: "/images/img_4532.jpg", title: "Biblioteca Giuridica" },
  { src: "/images/img_4544.jpg", title: "Ufficio Avv. Perlasca" },
  { src: "/images/img_4553.jpg", title: "Dettaglio Studio" },
  { src: "/images/img_4557.jpg", title: "Postazione Lavoro" },
  { src: "/images/img_4563.jpg", title: "Archivio Pratiche" },
];
---

<Layout 
  title="Dove trovarci | Studio Legale Perlasca Brescia"
  description="La posizione su google maps e immagini del nostro studio in Via Armando Diaz 7, Brescia."
>

  <!-- PAGE HEADER -->
  <section class="bg-primary-950 text-white py-16 sm:py-20 relative overflow-hidden">
    <div class="absolute inset-0 z-0 opacity-20">
      <img 
        src="/images/img_4531.jpg" 
        alt="Studio Legale Perlasca Brescia" 
        class="w-full h-full object-cover"
      />
    </div>
    <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-3">
      <span class="text-xs uppercase tracking-widest text-gold-400 font-bold">Studio Legale Perlasca</span>
      <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-white">
        Ecco dove trovarci
      </h1>
      <p class="text-sm sm:text-base text-slate-300">
        La posizione su google maps e immagini del nostro studio
      </p>
    </div>
  </section>

  <!-- OFFICE PHOTO GALLERY -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-2xl mx-auto mb-12 space-y-2">
        <h2 class="font-serif text-2xl sm:text-3xl font-bold text-primary-950">
          Ecco alcune immagini
        </h2>
        <p class="text-slate-600 text-sm sm:text-base">
          Questo è il nostro studio a Brescia, professionale e adatto ad ogni tua esigenza
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {officePhotos.map((photo) => (
          <div class="bg-slate-50 rounded-2xl overflow-hidden border border-slate-200 shadow-xs card-hover">
            <div class="h-60 overflow-hidden">
              <img 
                src={photo.src} 
                alt={photo.title} 
                class="w-full h-full object-cover hover:scale-105 transition-transform duration-300"
                loading="lazy"
              />
            </div>
            <div class="p-3.5 text-center bg-white border-t border-slate-100">
              <span class="font-serif font-bold text-sm text-primary-950">{photo.title}</span>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- LOCATION & MAP SECTION -->
  <section class="py-16 bg-slate-50 border-t border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <div class="text-center max-w-2xl mx-auto space-y-2">
        <h2 class="font-serif text-2xl sm:text-3xl font-bold text-primary-950">
          Vieni a trovarci
        </h2>
        <p class="text-slate-600 text-sm sm:text-base">
          Ecco il modo più comodo per venirci a trovare... ti aspettiamo
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
        
        <!-- Address & Directions -->
        <div class="lg:col-span-5 bg-white rounded-2xl p-8 border border-slate-200 shadow-xs flex flex-col justify-between space-y-6">
          <div class="space-y-4">
            <div>
              <span class="text-xs font-bold uppercase tracking-wider text-gold-700 block">Sede Principale</span>
              <h3 class="font-serif text-2xl font-bold text-primary-950">Studio legale Perlasca</h3>
            </div>

            <div class="space-y-2 text-slate-700 text-base">
              <p class="font-medium">Via Armando Diaz 7, Brescia, BS, 25121</p>
            </div>

            <div class="p-4 bg-slate-50 border-l-4 border-gold-500 rounded-r-lg space-y-1 text-sm text-slate-700">
              <span class="font-bold text-primary-950 block">Ti aspettiamo...</span>
              <p>Trova la strada più veloce e fissa un appuntamento al <a href="tel:+3903046785" class="font-bold text-primary-950 hover:underline">030 46785</a></p>
            </div>
          </div>

          <div>
            <a 
              href="https://maps.google.com/?q=Via+Armando+Diaz+7+25121+Brescia" 
              target="_blank" 
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 w-full px-5 py-3 rounded-lg text-xs font-bold uppercase tracking-wider text-primary-950 bg-gold-400 hover:bg-gold-500 transition-colors shadow-xs"
            >
              Apri su Google Maps →
            </a>
          </div>
        </div>

        <!-- Google Map Embed -->
        <div class="lg:col-span-7 rounded-2xl overflow-hidden border border-slate-200 shadow-xs min-h-[360px] bg-slate-100">
          <iframe 
            title="Mappa Studio Legale Perlasca Brescia"
            width="100%" 
            height="100%" 
            style="border:0; min-height: 360px;" 
            loading="lazy" 
            allowfullscreen 
            referrerpolicy="no-referrer-when-downgrade"
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2793.5828453412356!2d10.220194876694857!3d45.53457197107519!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x47817646b9a8cfab%3A0x6b772c659e9c70b6!2sVia%20Armando%20Diaz%2C%207%2C%2025121%20Brescia%20BS!5e0!3m2!1sit!2sit!4v1700000000000!5m2!1sit!2sit"
          ></iframe>
        </div>

      </div>

    </div>
  </section>

  <!-- PROFESSIONISTI -->
  <section class="py-16 bg-white border-t border-slate-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center mb-10">
        <h2 class="font-serif text-2xl sm:text-3xl font-bold text-primary-950">
          I Professionisti
        </h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-8">
        
        <div class="bg-slate-50 rounded-2xl p-6 sm:p-8 border border-slate-200 text-center shadow-xs card-hover space-y-3">
          <div class="w-14 h-14 rounded-full bg-primary-100 text-primary-900 mx-auto flex items-center justify-center">
            <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
          </div>
          <h4 class="font-serif font-bold text-xl text-primary-950">Cristiano Perlasca</h4>
          <a href="tel:+39335235766" class="block text-sm font-bold text-primary-900 hover:text-primary-700">
            +39 335 23 5766
          </a>
          <p class="text-xs text-gold-700 font-bold uppercase tracking-wider">Avvocato</p>
        </div>

        <div class="bg-slate-50 rounded-2xl p-6 sm:p-8 border border-slate-200 text-center shadow-xs card-hover space-y-3">
          <div class="w-14 h-14 rounded-full bg-primary-100 text-primary-900 mx-auto flex items-center justify-center">
            <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
          </div>
          <h4 class="font-serif font-bold text-xl text-primary-950">Paola Scolari</h4>
          <a href="tel:+393331205093" class="block text-sm font-bold text-primary-900 hover:text-primary-700">
            +39 333 120 5093
          </a>
          <p class="text-xs text-gold-700 font-bold uppercase tracking-wider">Avvocato</p>
        </div>

      </div>

    </div>
  </section>

</Layout>
